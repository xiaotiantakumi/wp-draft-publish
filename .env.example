# wp-draft-publisher — copy this to ".env" (same folder as the script) and fill in.
# NEVER commit the real .env. Values here are read as environment variables.
# Precedence: already-set env vars (exported / secret manager) win; .env only fills gaps.

# WordPress base URL. IMPORTANT: include the subdirectory if WP lives in one.
#   e.g. https://example.com  or  https://example.com/blog
WP_URL=https://example.com/blog

# WordPress login name (the username you log in with).
WP_USERNAME=your_login

# Application Password: WP admin > Users > Profile > "Application Passwords".
# Generate one, paste it here. Spaces are fine (they are stripped automatically).
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
